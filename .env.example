# Copy this file to .env for local development.
# Never commit the copied .env file or put real credentials in this example.

# Qwen/DashScope server credential. Required for real chat requests.
DASHSCOPE_API_KEY=

# Optional Doubao server credential for the future Doubao adapter.
DOUBAO_API_KEY=

# Optional Web token when NOVAAGENT_WEB_AUTH_MODE=token.
NOVAAGENT_WEB_TOKEN=
